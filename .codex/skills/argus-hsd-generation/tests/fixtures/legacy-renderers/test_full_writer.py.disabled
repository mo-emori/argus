from __future__ import annotations

import hashlib
import json
from pathlib import Path

import full_writer
import pytest
from contracts import canonical_digest
from full_writer import PROTECTION_MECHANISMS, phase_b_gate, run
from writer_poc import SECTIONS, mechanical_gate

ROOT = Path(__file__).resolve().parents[1]
REPO = ROOT.parents[2]
PLAN = REPO / "validation/reports/argus-p-0087-v1/planning-artifact.json"
SDD = REPO / "docs/model/argus_structured_design_data_v0.1.md"
P0088 = REPO / "work/argus-p-0088-v1"
PLANNING_HASH = "e3b59df6d6b4de9a41d3c329d3603f7d7e4bf675de92f42df841a27c1329d696"
SDD_HASH = "0acc60f6bff9ae27fea86310b0160e2b344e9671a795798feb763334ddeebf40"


def planning():  # type: ignore[no-untyped-def]
    return json.loads(PLAN.read_text("utf-8"))


def test_phase_b_detects_old_overcompressed_form() -> None:
    plan = planning()
    context = next(item for item in plan["sections"] if item["section_id"] == "6.1")
    before = (P0088 / "sections/section-6.1.md").read_bytes()
    gate = phase_b_gate(before, before.decode("utf-8"), plan, mechanical_gate("6.1", before.decode("utf-8"), context))
    assert gate["status"] == "FAIL"
    assert gate["checks"]["enumerated_or_table"] is False


def test_phase_b_preserves_all_mechanism_correspondences() -> None:
    assert all(item in SECTIONS["6.1"] for item in PROTECTION_MECHANISMS)


def test_phase_b_failure_prevents_expansion(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    old = (P0088 / "sections/section-6.1.md").read_text("utf-8")
    monkeypatch.setitem(full_writer.SECTIONS, "6.1", old)
    result = run(PLAN, SDD, P0088, tmp_path, PLANNING_HASH, SDD_HASH)
    assert result["generated_sections"] == 1
    assert not (tmp_path / "argus_human_system_design_working_draft.md").exists()


def test_full_run_keeps_accepted_sections_and_tracks_coverage(tmp_path: Path) -> None:
    result = run(PLAN, SDD, P0088, tmp_path, PLANNING_HASH, SDD_HASH)
    assert result["generated_sections"] == 39
    assert (tmp_path / "sections/section-2.1.md").read_bytes() == (P0088 / "sections/section-2.1.md").read_bytes()
    assert (tmp_path / "sections/section-5.4.md").read_bytes() == (P0088 / "sections/section-5.4.md").read_bytes()
    assert result["whole"]["coverage"]["units"] == 951
    assert result["whole"]["coverage"]["assignment_review_required"] == 114


def test_assembly_uses_all_sections_without_rewriting(tmp_path: Path) -> None:
    run(PLAN, SDD, P0088, tmp_path, PLANNING_HASH, SDD_HASH)
    draft = (tmp_path / "argus_human_system_design_working_draft.md").read_text("utf-8")
    assert sum(1 for line in draft.splitlines() if line.startswith("## ") and not line.startswith("## 目次")) == 39
    assert SECTIONS["6.1"] in draft


def test_writer_context_payloads_exclude_raw_sources(tmp_path: Path) -> None:
    run(PLAN, SDD, P0088, tmp_path, PLANNING_HASH, SDD_HASH)
    payload = json.loads((tmp_path / "contexts/section-1.1.json").read_text("utf-8"))
    assert set(payload) == {"context", "writing_rules", "approved_references"}


def test_coverage_digest_matches_approved_planning() -> None:
    plan = planning()
    digest = canonical_digest([(item["section_id"], item["coverage_units"]) for item in plan["sections"]])
    assert digest == "e08599c73f8afc9055eebd37968e25384f4e547506d7f1a03ca4af49f68fcfcc"


def test_deterministic_full_generation(tmp_path: Path) -> None:
    first, second = tmp_path / "a", tmp_path / "b"
    run(PLAN, SDD, P0088, first, PLANNING_HASH, SDD_HASH)
    run(PLAN, SDD, P0088, second, PLANNING_HASH, SDD_HASH)
    left = {path.relative_to(first): hashlib.sha256(path.read_bytes()).hexdigest() for path in first.rglob("*") if path.is_file()}
    right = {path.relative_to(second): hashlib.sha256(path.read_bytes()).hexdigest() for path in second.rglob("*") if path.is_file()}
    assert left == right
