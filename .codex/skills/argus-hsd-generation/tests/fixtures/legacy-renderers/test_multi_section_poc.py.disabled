from __future__ import annotations

import hashlib
import json
from pathlib import Path

from human_facing_gate import evaluate_human_facing
from multi_section_poc import PLANS, SECTIONS, SELECTED, plan_gate, run, select_sections

ROOT = Path(__file__).resolve().parents[1]
REPO = ROOT.parents[2]
PLAN = REPO / "validation/reports/argus-p-0087-v1/planning-artifact.json"
SDD = REPO / "docs/model/argus_structured_design_data_v0.1.md"
P0088 = REPO / "work/argus-p-0088-v1"
P0090 = REPO / "work/argus-p-0090-v1"
PLANNING_HASH = "e3b59df6d6b4de9a41d3c329d3603f7d7e4bf675de92f42df841a27c1329d696"
SDD_HASH = "0acc60f6bff9ae27fea86310b0160e2b344e9671a795798feb763334ddeebf40"


def planning():  # type: ignore[no-untyped-def]
    return json.loads(PLAN.read_text("utf-8"))


def test_selection_is_deterministic_and_uses_distinct_types() -> None:
    selected = select_sections(planning())
    assert {kind: selected["types"][kind]["selected"] for kind in SELECTED} == SELECTED
    assert all(len(selected["types"][kind]["candidates"]) == 3 for kind in SELECTED)


def test_all_human_structure_plans_pass_type_aware_gate() -> None:
    assert all(plan_gate(kind, PLANS[section_id])["status"] == "PASS" for kind, section_id in SELECTED.items())
    assert not PLANS["1.2"]["diagram_candidates"]


def test_generated_sections_pass_human_facing_gate() -> None:
    assert all(evaluate_human_facing(SECTIONS[section_id])["status"] == "PASS" for section_id in SELECTED.values())


def test_section_shapes_are_not_a_shared_template() -> None:
    headings = {section_id: tuple(line for line in text.splitlines() if line.startswith("### ")) for section_id, text in SECTIONS.items()}
    assert len(set(headings.values())) == 3
    assert SECTIONS["1.2"].count("```mermaid") == 0
    assert SECTIONS["7.1"].count("```mermaid") == 1


def test_run_generates_only_selected_sections_and_keeps_full_hsd(tmp_path: Path) -> None:
    draft = REPO / "work/argus-p-0089-v1/argus_human_system_design_working_draft.md"
    before = hashlib.sha256(draft.read_bytes()).hexdigest()
    result = run(PLAN, SDD, P0088, P0090, tmp_path, PLANNING_HASH, SDD_HASH)
    assert result["status"] == "PASS"
    assert {path.stem.removeprefix("section-") for path in (tmp_path / "sections").glob("*.md")} == set(SELECTED.values())
    assert hashlib.sha256(draft.read_bytes()).hexdigest() == before


def test_regression_baselines_keep_expected_results(tmp_path: Path) -> None:
    run(PLAN, SDD, P0088, P0090, tmp_path, PLANNING_HASH, SDD_HASH)
    report = json.loads((tmp_path / "regression-verification.json").read_text("utf-8"))
    assert report["known_bad_3_4"]["status"] == "FAIL"
    assert all(report[key]["status"] == "PASS" for key in ("accepted_2_1", "accepted_5_4", "accepted_3_4"))


def test_deterministic_regeneration(tmp_path: Path) -> None:
    first, second = tmp_path / "a", tmp_path / "b"
    run(PLAN, SDD, P0088, P0090, first, PLANNING_HASH, SDD_HASH)
    run(PLAN, SDD, P0088, P0090, second, PLANNING_HASH, SDD_HASH)
    left = {path.relative_to(first): hashlib.sha256(path.read_bytes()).hexdigest() for path in first.rglob("*") if path.is_file()}
    right = {path.relative_to(second): hashlib.sha256(path.read_bytes()).hexdigest() for path in second.rglob("*") if path.is_file()}
    assert left == right
