from __future__ import annotations

import json
from pathlib import Path

from drift_load_poc import EXCLUDED, select_and_order

ROOT = Path(__file__).parents[4]
PLANNING = ROOT / "validation/reports/argus-p-0087-v1/planning-artifact.json"


def test_selection_is_fixed_unique_and_excludes_prior_sections() -> None:
    planning = json.loads(PLANNING.read_text("utf-8"))
    first = select_and_order(planning)
    second = select_and_order(planning)
    assert first == second
    assert len(first) == 20
    assert len({item["section_id"] for item in first}) == 20
    assert not ({item["section_id"] for item in first} & EXCLUDED)
    assert [item["position"] for item in first] == list(range(1, 21))


def test_selection_is_not_plain_section_order_and_is_mixed() -> None:
    planning = json.loads(PLANNING.read_text("utf-8"))
    selected = select_and_order(planning)
    assert [item["section_id"] for item in selected] != sorted(item["section_id"] for item in selected)
    assert len({item["kind"] for item in selected[:10]}) >= 3
    assert len({item["kind"] for item in selected[10:]}) >= 3
